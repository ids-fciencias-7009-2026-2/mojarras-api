            "url": {
              "raw": "{{baseUrl}}/publications/{{publicationId}}/photos/{{photoId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "publications",
                "{{publicationId}}",
                "photos",
                "{{photoId}}"
              ]
            }
          },
          "response": []
        }
      ]
